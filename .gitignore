# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ── Build output ──────────────────────────────────────────────────────────────
.next/
out/
build/
dist/

# ── Environment & Secrets (NEVER commit these) ────────────────────────────────
# Add all variables to Netlify Dashboard → Site Settings → Environment Variables
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env*.local

# Keep the example template so other devs know what vars are needed
!.env.example

# ── Database ──────────────────────────────────────────────────────────────────
prisma/dev.db
prisma/dev.db-journal
prisma/*.db
prisma/*.db-journal

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Deploy artifacts ──────────────────────────────────────────────────────────
.vercel
.netlify

# ── Misc ─────────────────────────────────────────────────────────────────────
scratch/
tmp/
temp/
coverage/
