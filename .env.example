# ══════════════════════════════════════════════════════════════════════════════
# ALMARTO — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# On Netlify: add each variable in Dashboard → Site Settings → Environment Variables
# ══════════════════════════════════════════════════════════════════════════════

# ── Supabase PostgreSQL (Transaction Pooler — used by Prisma at runtime) ──────
# Format: postgresql://[user]:[password]@[host]:[port]/[db]?pgbouncer=true&...
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=30&connect_timeout=15&statement_cache_size=0"

# ── Supabase Direct Connection (used by Prisma CLI for migrations only) ───────
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?connect_timeout=15"

# ── Supabase Auth & Storage ───────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR_SUPABASE_ANON_KEY]"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="[YOUR_SUPABASE_PUBLISHABLE_KEY]"

# ── Auth & Security ───────────────────────────────────────────────────────────
# Generate a strong random string: openssl rand -base64 32
JWT_SECRET="[RANDOM_32_CHAR_SECRET]"
ADMIN_SECRET_KEY="[YOUR_ADMIN_SECRET]"

# ── Email / SMTP (optional — for OTP & order emails) ─────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-specific-password"
SMTP_FROM="ALMARTO <noreply@almarto.com>"
